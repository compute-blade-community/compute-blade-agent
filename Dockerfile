FROM cgr.dev/chainguard/wolfi-base
LABEL org.opencontainers.image.source="https://github.com/compute-blade-community/compute-blade-agent"

# Copy binaries generated by goreleaser, which lays them out per platform in the build context
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/compute-blade-agent $TARGETPLATFORM/bladectl /bin/

ENTRYPOINT ["/bin/compute-blade-agent"]
